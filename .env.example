GEMINI_API_KEY=your_key_here
# Embedding model: a local sentence-transformers model (default, no API key) or a
# Gemini "models/..." name to use the Gemini embedding API (requires API key).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_MODEL=gemini-2.5-flash
EMBEDDING_DIM=384

CHUNK_SIZE=800
CHUNK_OVERLAP=150

TOP_K=4
SIMILARITY_THRESHOLD=0.35

INDEX_DIR=data/index
UPLOAD_DIR=data/uploads
